# The channel-classification seed `[PI3-FOUND-520]`: installed and NOT enabled.
# An experiment, withdrawn on lempi02w the evening it ran `[PI3-FOUND-530]` --
# the seed reached the controller and the audio stuttered as before -- and
# installed on lp3-wifi at the maintainer's request, 2026-10-23, for a trial of
# its own. Turn it on only with a map saved while the link sounds right
# (`lempi-afh-seed save`), and off again if the trial fails.
#
# The same unit LempiPi/setup-appliance.sh writes from its own heredoc on
# lempi02w; a change to one is a change to both.
[Unit]
Description=Seed the controller with this room's channel classification (experiment)
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/lempi-afh-seed boot
# Seven passes at ten-second intervals is about a minute by design, so this
# clears it comfortably. Finite because `Type=oneshot` defaults to infinity
# `[PI3-FOUND-670]`, and this one talks to `hcitool`.
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target

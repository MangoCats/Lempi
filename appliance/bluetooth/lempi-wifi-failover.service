# The Wi-Fi keeper: holds a link still, shows on the LED whether there is one, and
# watches the access point while it is up [SPEC061], [IMPL022]. It no longer
# starts the access point by itself [SPEC-WFO-090].
[Unit]
Description=Hold the Wi-Fi link, show it on the LED, and watch the access point
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/lempi-wifi-failover
TimeoutStartSec=60

#!/bin/sh
# Keep the appliance reachable by failing over to lempi-ap when disconnected [SPEC061], [IMPL022].
#
# Runs periodically via lempi-wifi-failover.timer.
# Evaluates link state, boot grace period, rfkill status, and debounce thresholds
# before executing lempi-btctl ap-failover without scheduling a revert timer.
set -u

STATE_DIR="${LEMPI_RUN_DIR:-/run/lempi}"
RFKILL_DIR="${SYS_CLASS_RFKILL:-/sys/class/rfkill}"
PROC_UPTIME="${PROC_UPTIME:-/proc/uptime}"
BTCTL="${LEMPI_BTCTL:-/usr/local/bin/lempi-btctl}"
# How long the access point sits with no clients before the keeper tries the
# way home [SPEC-WFO-080]: the spec's fifteen minutes.
RETURN_AFTER="${LEMPI_AP_RETURN_AFTER:-900}"

# While the access point is up: who is on it, and the way home when nobody is
# [SPEC-WFO-080], built 2026-10-10.
#
# The access point used to be a one-way door. Once up it stayed up until a
# reboot -- a router restarted for thirty seconds left the appliance off the
# household's network for good. Now an access point with no clients for
# RETURN_AFTER tries the known network once (`lempi-btctl ap-return`, which
# puts the access point straight back if that fails), and the idle clock
# restarts, so a failed try is another full idle period from the next.
#
# Clients are the stations `iw` lists as associated -- a phone that joined is
# one, whether or not it ever opened the page. A change in their number is
# said in the journal, which is the record of when anyone joined or left.
#
# Unlike the spec's optional probe, this does not wait for audio to be idle:
# an appliance that plays all day never is, and a way home that never runs is
# no way home. It does not scan either [SPEC-WFO-070] -- `nmcli connection up`
# of a known profile -- and it runs at most once per idle period.
ap_watch() {
    mkdir -p "$STATE_DIR"
    if ! DUMP=$(iw dev wlan0 station dump 2>&1); then
        # Cannot see the clients, so cannot know nobody is using it: stay.
        # Said once per access-point session, not every twenty seconds.
        if [ ! -f "$STATE_DIR/ap_iw_failed" ]; then
            echo "cannot list the access point's clients ($DUMP); staying on it"
            : > "$STATE_DIR/ap_iw_failed"
        fi
        return 0
    fi
    rm -f "$STATE_DIR/ap_iw_failed"
    N=$(printf '%s\n' "$DUMP" | grep -c '^Station')
    WAS=$(cat "$STATE_DIR/ap_clients" 2>/dev/null || echo 0)
    if [ "$N" != "$WAS" ]; then
        echo "access point clients: $WAS -> $N"
        printf '%s\n' "$N" > "$STATE_DIR/ap_clients"
    fi
    NOW=$(date +%s)
    if [ "$N" -gt 0 ]; then
        rm -f "$STATE_DIR/ap_idle_since"
        return 0
    fi
    if [ ! -f "$STATE_DIR/ap_idle_since" ]; then
        printf '%s\n' "$NOW" > "$STATE_DIR/ap_idle_since"
        return 0
    fi
    SINCE=$(cat "$STATE_DIR/ap_idle_since" 2>/dev/null || echo "$NOW")
    IDLE=$((NOW - SINCE))
    [ "$IDLE" -ge "$RETURN_AFTER" ] || return 0
    rm -f "$STATE_DIR/ap_idle_since" "$STATE_DIR/ap_clients"
    echo "access point idle for ${IDLE}s with no clients: trying the known network"
    if OUT=$("$BTCTL" ap-return 2>&1); then
        echo "back on the known network; the access point is down"
    else
        echo "did not get back ($OUT)"
    fi
}

# 1. Radio State Guard: if Wi-Fi is soft-blocked by operator intent, honor it.
if [ -d "$RFKILL_DIR" ]; then
    for r in "$RFKILL_DIR"/rfkill*; do
        [ -f "$r/type" ] || continue
        if [ "$(cat "$r/type" 2>/dev/null)" = "wlan" ]; then
            if [ "$(cat "$r/soft" 2>/dev/null)" = "1" ]; then
                exit 0
            fi
        fi
    done
fi

# 2. In-Flight Revert Guard: if a user network switch is underway, defer to it.
if systemctl list-timers 'lempi-revert-*' 2>/dev/null | grep -q 'lempi-revert-'; then
    exit 0
fi

# 3. Boot Grace Period (45 seconds): allow time for home Wi-Fi association on boot.
UPTIME=$(cut -d. -f1 "$PROC_UPTIME" 2>/dev/null || echo 0)
if [ "$UPTIME" -lt 45 ]; then
    exit 0
fi

# 4. Connection Check: if connected or connecting, do nothing; if already in
#    AP mode, watch its clients and the way home.
ACTIVE_CONNS=$(nmcli -t -f NAME,TYPE,ACTIVE connection show 2>/dev/null || true)
if printf '%s\n' "$ACTIVE_CONNS" | grep -q '^lempi-ap:.*:yes$'; then
    rm -f "$STATE_DIR/wifi_disconnected_since"
    ap_watch
    exit 0
fi
# Not on the access point: its client count and idle clock start fresh next time.
rm -f "$STATE_DIR/ap_idle_since" "$STATE_DIR/ap_clients" "$STATE_DIR/ap_iw_failed"

DEV_STATE=$(nmcli -t -f DEVICE,STATE dev 2>/dev/null | grep '^wlan0:' || true)
case "$DEV_STATE" in
    wlan0:connected|wlan0:connecting)
        rm -f "$STATE_DIR/wifi_disconnected_since"
        exit 0
        ;;
esac

# 5. Debounce Tracker: wait 30 continuous seconds of disconnection before acting.
mkdir -p "$STATE_DIR"
NOW=$(date +%s)
DEBOUNCE_FILE="$STATE_DIR/wifi_disconnected_since"

if [ ! -f "$DEBOUNCE_FILE" ]; then
    printf '%s\n' "$NOW" > "$DEBOUNCE_FILE"
    exit 0
fi

SINCE=$(cat "$DEBOUNCE_FILE" 2>/dev/null || echo "$NOW")
ELAPSED=$((NOW - SINCE))

if [ "$ELAPSED" -ge 30 ]; then
    # 6. Autonomous Bringup: standing AP bringup without revert timer.
    # Said out loud: the unit's routine runs are kept out of the journal
    # [PI3-FOUND-760], so this line is the only trace a failover leaves.
    echo "wlan0 down for ${ELAPSED}s ($DEV_STATE): bringing up the access point"
    "$BTCTL" ap-failover >/dev/null 2>&1 || { echo "the access point did not come up"; exit 1; }
    rm -f "$DEBOUNCE_FILE"
fi

exit 0

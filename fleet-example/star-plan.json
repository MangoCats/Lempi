{
 "hub": {"name": "desk", "listener": "data/listener.db", "library": "data/library.db"},
 "runs": "data/sync",
 "prune": {"prefix": "pre-sync-", "keep": 3},
 "backups": {"dir": "data/backups", "keep_daily": 14, "keep_monthly": 12, "max_age_hours": 30,
             "mirror": {"host": "someone@workshop", "dir": "/home/someone/lempi-hub-backups"}},
 "nodes": {
  "speaker-a": {"host": "pi@speaker-a", "member": "<the player's mesh fingerprint>"},
  "speaker-b": {"host": "someone@speaker-b", "member": "<its mesh fingerprint>"},
  "workshop": {"host": "someone@workshop", "member": "<its mesh fingerprint>",
               "on_demand": {"start": "XDG_RUNTIME_DIR=/run/user/$(id -u) systemctl --user start lempi-ondemand.service",
                             "stop": "XDG_RUNTIME_DIR=/run/user/$(id -u) systemctl --user stop lempi-ondemand.service"}}
 }
}

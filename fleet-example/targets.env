# What the console's generated commands and peer labels should say.
#
# **Generic on purpose.** This is the tracked example; it names no real
# machine. A household copies it to `fleet/targets.env` -- which is
# gitignored -- and puts its own hosts in. With no `fleet/targets.env`
# present the console renders these values, so the pages still make sense to
# a reader who has no fleet at all, and an operator who copies a command gets
# a host that plainly does not exist rather than one that might be the wrong
# real machine.
#
# Same precedence idea as the player's own options `[GDE-CLI-090]`: the
# specific one if it is defined, the generic one otherwise.

# The peer this console pushes to and pulls from.
LEMPI_PEER_NAME=speaker-a
LEMPI_PEER_USER=pi
LEMPI_PEER_PORT=13491

# Where the library and incoming bundles live on that peer.
LEMPI_PEER_LIBRARY=/srv/library/library.db
LEMPI_PEER_INCOMING=/srv/library/incoming

# A second name, used only in "e.g. ..." placeholder text.
LEMPI_EXAMPLE_PEER=speaker-b

# Layer 3 for a whole machine [GDE-CLI-090]. Generic example; 13491 is not
# the default port.
#
# Sourced by a shell, or named by `EnvironmentFile=` in a unit. Every option
# of every binary has a variable here by derivation: strip `--`, uppercase,
# hyphens to underscores, prefix `LEMPI_`. Nothing lists them -- the name
# follows from the option, so it cannot go stale when the option is renamed.
#
# The command line still wins over anything here, and a stored setting wins
# over it for the options that have one. What is set here loses only to
# those two, and beats the built-in default.

# Where the player serves. One export moves it for everything on the box.
LEMPI_PORT=13491

# The two halves of a split library [IMPL-DBSPLIT-025]. These two are
# BOOTSTRAP options [GDE-CLI-095]: they name the database the stored
# settings live in, so they are never answered by the stored settings --
# only by the command line, this file, or the built-in default.
LEMPI_LISTENER=/var/lempi/listener.db
LEMPI_LIBRARY=/srv/library/library.db

# Output device, matched as a case-insensitive substring of the cpal name.
# `lempi --list-devices` prints what this machine actually offers.
LEMPI_DEVICE=hifiberry

# An MPD guest, if this machine has one [SPEC-BK-020].
#LEMPI_MPD=127.0.0.1:6600
#LEMPI_MPD_ROOT=/srv/library/audio

# **Not everything is settable here, on purpose** [GDE-CLI-105]. The flags
# that make a program write -- `--apply` in relink and import_bundle,
# `--write` in the MPD tools -- are off the environment layer entirely. An
# exported LEMPI_APPLY left in a shell would turn reporting into writing at a
# distance, with nothing on the command line to show for it.

#!/bin/sh
# Refuse a commit that cannot build for the machines this code ships to.
#
# Two checks, both about the same gap -- what works on the Windows machine the
# code is written on and not on the Linux ones it runs on: (1) a staged script
# with a shebang and no executable bit, on every commit; (2) a Linux compile,
# when `player/` or `sql/` is staged. (2) is what this hook was written for;
# (1) was added after the hook itself shipped without its executable bit.
#
# **Written because the fault it catches reached an appliance deploy.** On
# 2026-09-22 `lempi-core` was committed naming `libc` in `#[cfg(unix)]` code
# without depending on it. Windows never compiles that branch, so a full host
# build, every feature combination, `clippy --all-targets` and 598 passing
# tests all agreed the commit was fine. `build/deploy-appliance.sh` found it,
# at the point of shipping, on the first aarch64 cross-compile.
#
# `build/verify-targets.sh` already existed to catch exactly that and was not
# run. So the fix is not a new check -- it is running the one already written,
# at the moment the mistake is made rather than the moment it ships.
#
# ---------------------------------------------------------------- scope ---
#
# It runs only when something under `player/` or `sql/` is staged. This
# repository commits far more documentation than code, and a gate that taxes a
# docs commit is a gate someone turns off. Measured 2026-09-22: 22 s on a warm
# no-op, 14 s after a core edit, 46 s cold.
#
# ------------------------------------------------------------- escaping ---
#
# Each check has its OWN escape, and each **says so in the terminal rather than
# passing quietly** -- CLAUDE.md §5: a skipped guard must be a loud line, not a
# silent reason, which is why `--no-verify` (no trace) is the wrong tool:
#   `LEMPI_SKIP_VERIFY=1` -- the slow Linux cross-compile only (section 2);
#   `LEMPI_SKIP_LEAKS=1`  -- the fleet-leak scan only (section 1b).
# The two are separate on purpose `[SecurityReview2 R5]`: skipping the slow
# compile must not also quietly skip the fast privacy scan. The executable-bit
# check has no escape -- it is sub-second and never worth skipping.
#
# ------------------------------------------------------------ enabling ----
#
#     git config core.hooksPath .githooks
#
# Per clone, and not automatic -- git will not run hooks from a tracked
# directory until told to. See CLAUDE.md §10.

set -u

ROOT=$(git rev-parse --show-toplevel)

# The two fast checks below (executable bits, fleet leaks) run on EVERY commit
# and are not skipped by `LEMPI_SKIP_VERIFY`. That variable exists to commit
# past the slow Linux cross-compile (section 2), and coupling the fast privacy
# scan to the slow-compile escape meant a leak could slip out whenever someone
# skipped the compile `[SecurityReview2 R5]`. Each fast check now has its own
# escape, said out loud: `LEMPI_SKIP_LEAKS=1` for the leak scan.

# ---- 1. every staged script is executable: every commit -----------------
#
# Well under a second, so it runs whatever is staged. Added 2026-09-24 after
# this hook was itself committed `100644` in `175c3ef` -- a file git will not
# run on Linux. CI's `executable-bits` job would have caught it, but only after
# a push; `tools/check_exec_bits.py` reads the mode from the index, which git
# keeps on Windows too, so the same rule can run here, before the commit.
#
# An interpreter that exists is not one that runs: on some Windows machines
# `python3` is a Store stub. So the first that runs `pass` is used, and none
# running is a failure rather than a skip `[GDE-DEP-060]`.
PY=""
for candidate in python3 python; do
    if "$candidate" -c "pass" >/dev/null 2>&1; then
        PY=$candidate
        break
    fi
done
if [ -z "$PY" ]; then
    echo "pre-commit: no working python3 or python, so the executable-bit check DID NOT RUN."
    echo "pre-commit: that is a failure, not a pass. LEMPI_SKIP_VERIFY=1 commits anyway, out loud."
    exit 1
fi
if ! "$PY" "$ROOT/tools/check_exec_bits.py" --staged; then
    cat <<'EOF'

pre-commit: REFUSED -- a staged script opens with #! and is not executable.

Windows has no executable bit, so it runs here and will not run on Linux --
where every appliance, and CI, lives. Apply the `fix:` line above, which sets
the mode in the index, and commit again. A file that is sourced rather than
run says "Sourced, not run" in its header and is exempt.
EOF
    exit 1
fi

# ---- 1b. no new fleet leak in the lines this commit adds: every commit --
#
# Fast, like the exec-bit check, so it runs on every commit -- and, unlike the
# slow gate below, is NOT skipped by `LEMPI_SKIP_VERIFY` `[SecurityReview2 R5]`.
# It scans only the ADDED lines (`--staged`), so the private detail already in
# the tree -- left as-is by decision, 2026-09-28 -- does not block work, while a
# new leak is refused `[SecurityReview N1]`. Generic patterns always; the
# real-name denylist too when `fleet/private-tokens.txt` exists (not in CI).
if [ "${LEMPI_SKIP_LEAKS:-0}" = "1" ]; then
    echo "pre-commit: fleet-leak scan SKIPPED by LEMPI_SKIP_LEAKS=1 -- this commit's"
    echo "pre-commit: added lines were NOT scanned for private fleet detail."
elif ! "$PY" "$ROOT/tools/check_fleet_leaks.py" --staged --strict; then
    cat <<'EOF'

pre-commit: REFUSED -- a staged line looks like private fleet detail.

Use a documentation address (192.0.2.x, RFC 5737), a role alias, or move the
detail into the gitignored fleet/. A documented placeholder goes in the
allow-list in tools/check_fleet_leaks.py. LEMPI_SKIP_LEAKS=1 commits anyway,
out loud.
EOF
    exit 1
fi

# ---- 2. the Linux gate: only when player/ or sql/ is staged -------------
#
# Nothing this gate knows about? Then it has nothing to say. `--diff-filter=d`
# so a pure deletion does not trigger a compile of what is left.
staged=$(git diff --cached --name-only --diff-filter=d -- player sql)
if [ -z "$staged" ]; then
    exit 0
fi

# The slow gate, and the one `LEMPI_SKIP_VERIFY` is for -- said out loud, so an
# unverified commit leaves a trace, which `--no-verify` would not `[GDE-DEP-060]`.
if [ "${LEMPI_SKIP_VERIFY:-0}" = "1" ]; then
    echo "pre-commit: the Linux cross-compile gate is SKIPPED by LEMPI_SKIP_VERIFY=1;"
    echo "pre-commit: this commit's cfg(unix) code is unverified and may not build on the appliance."
    exit 0
fi

echo "pre-commit: $(printf '%s\n' "$staged" | grep -c .) staged file(s) under player/ or sql/ -- checking"

if sh "$ROOT/build/verify-targets.sh" --quick; then
    exit 0
fi

cat <<'EOF'

pre-commit: REFUSED.

The code compiles where you are writing it and not where it runs. That is the
exact shape of the bug this hook exists for, and a passing Windows suite is
not evidence against it.

  build/verify-targets.sh --quick     to see it again
  build/verify-targets.sh             the full three-target run
  LEMPI_SKIP_VERIFY=1 git commit ...  to commit anyway, out loud
EOF
exit 1

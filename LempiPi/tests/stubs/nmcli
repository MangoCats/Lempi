#!/bin/sh
# Fake nmcli for the wifi verbs. Records every call, and answers the reads the
# guards make. For `connection add` it writes a NetworkManager-shaped keyfile
# into $LEMPI_NM_DIR, so `set_psk`'s keyfile edit has something to edit and a
# test can prove the real psk lands there and never on any argv
# `[SecurityReview C3, C5]`.
printf '%s\n' "nmcli $*" >> "$VT_STATE/calls"

# The reads the guards make.
case "$*" in
  *"-t -f connection.type connection show "*)
    name=$(printf '%s' "$*" | sed 's/.*connection show //')
    t=$(sed -n "s/^$name=//p" "$VT_STATE/nm_types" 2>/dev/null)
    [ -n "$t" ] && printf 'connection.type:%s\n' "$t"
    exit 0 ;;
  *"-g connection.uuid connection show "*)
    # A deterministic uuid per connection name, so set_psk can find its keyfile.
    name=$(printf '%s' "$*" | sed 's/.*connection show //')
    [ -f "$LEMPI_NM_DIR/$name.nmconnection" ] && printf 'uuid-%s\n' "$name"
    exit 0 ;;
  *"-t -f DEVICE,NAME connection show --active"*)
    [ -f "$VT_STATE/nm_active" ] && printf 'wlan0:%s\n' "$(cat "$VT_STATE/nm_active")"
    exit 0 ;;
  *"-t -f NAME,TYPE,ACTIVE connection show"*)
    [ -f "$VT_STATE/nm_active_conns" ] && cat "$VT_STATE/nm_active_conns"
    exit 0 ;;
  *"-t -f DEVICE,STATE dev"*)
    [ -f "$VT_STATE/nm_dev_state" ] && cat "$VT_STATE/nm_dev_state"
    exit 0 ;;
esac

# Everything else dispatches on the connection subcommand.
[ "$1" = connection ] || exit 0
sub="$2"; shift 2
case "$sub" in
  add)
    conn=""; psk=""; secure=0
    while [ $# -gt 0 ]; do
      case "$1" in
        con-name) conn="$2"; shift 2 ;;
        wifi-sec.psk) psk="$2"; secure=1; shift 2 ;;
        wifi-sec.key-mgmt) secure=1; shift 2 ;;
        *) shift ;;
      esac
    done
    [ -n "$conn" ] && [ -n "$LEMPI_NM_DIR" ] || exit 0
    mkdir -p "$LEMPI_NM_DIR"
    f="$LEMPI_NM_DIR/$conn.nmconnection"
    # NM_UUID_MISMATCH=1 writes a uuid that `-g connection.uuid` will not
    # report, so set_psk cannot find the file -- exercising delete-on-failure.
    uuid="uuid-$conn"; [ "${NM_UUID_MISMATCH:-0}" = 1 ] && uuid="mismatch"
    {
      printf '[connection]\nid=%s\nuuid=%s\n\n[wifi]\nmode=infrastructure\n\n' "$conn" "$uuid"
      [ "$secure" = 1 ] && printf '[wifi-security]\nkey-mgmt=wpa-psk\npsk=%s\n\n' "$psk"
      printf '[ipv4]\nmethod=auto\n'
    } > "$f"
    chmod 600 "$f" 2>/dev/null
    exit 0 ;;
  delete)
    [ -n "$LEMPI_NM_DIR" ] && rm -f "$LEMPI_NM_DIR/$1.nmconnection" 2>/dev/null
    exit 0 ;;
  modify)
    # connection modify <name> connection.id <newid> -> rename the keyfile,
    # so the atomic AP swap can be exercised [SecurityReview3 R1a].
    # NM_RENAME_FAIL_FROM=<name> makes renaming that connection fail, leaving
    # it as it was -- exercising the swap's put-it-back path.
    if [ "${2:-}" = connection.id ] && [ "$1" = "${NM_RENAME_FAIL_FROM:-}" ]; then
      exit 1
    fi
    if [ "${2:-}" = connection.id ] && [ -n "$LEMPI_NM_DIR" ]; then
      old="$LEMPI_NM_DIR/$1.nmconnection"; new="$LEMPI_NM_DIR/$3.nmconnection"
      if [ -f "$old" ]; then
        sed -e "s/^id=$1\$/id=$3/" -e "s/^uuid=uuid-$1\$/uuid=uuid-$3/" "$old" > "$new"
        rm -f "$old"
      fi
    fi
    exit 0 ;;
  up|down|reload)
    exit 0 ;;
esac
exit 0

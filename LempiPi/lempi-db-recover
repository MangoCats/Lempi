#!/bin/sh
# Roll back any hot SQLite journal before the player opens anything.
#
# **`[PI3-FOUND-120]` On this appliance every power-down is a power CUT.**
# lempipi is fed from the Middleton's own USB port `[PI3-FOUND-090]`, so
# switching the speaker off yanks the supply from a running Linux system with
# open databases. There is no shutdown, and there is no warning there could
# have been one. That is not misuse -- it is the only way the hardware can be
# switched off -- so it has to be a supported event rather than an accident.
#
# What it leaves behind depends on the journal mode, and BOTH shapes matter
# here since `[PI-OWE-030]` put these databases into WAL on 2026-09-11:
#
#   `delete` mode  a hot rollback journal, `listener.db-journal`, holding the
#                  pages of a transaction that never committed.
#   WAL            a `listener.db-wal` with frames never checkpointed into the
#                  database, and a `-shm` index that may need rebuilding.
#
# The recovery is the same act for both -- one read-write open -- but the
# EVIDENCE is not, and that difference is the whole of this script's
# reporting. A `-journal` beside a database means an unclean stop and nothing
# else. A `-wal` is an ordinary part of a WAL database in use, so its mere
# presence proves nothing; a NON-EMPTY one at `ExecStartPre`, before anything
# has opened the database, is the equivalent signal. SQLite's contract is that the next connection to open that
# database rolls it back. The catch is that rolling back is a WRITE, and
# Lempi attaches its databases `mode=ro` -- deliberately, so the player
# cannot corrupt the library `[IMPL-DBSPLIT-025]`. A read-only connection
# cannot perform the recovery it is required to perform, so it fails, with
# `attempt to write a readonly database`, for ever.
#
# Measured 2026-09-08, after a power cycle: `lempi.service` failed on that
# error and `Restart=always` turned it into a crash loop -- 23 restarts, no
# web interface, no audio, and nothing in the failure that pointed at a
# journal file. Recovering by hand took one read-write open. This does that
# open, every start, so the appliance heals itself instead of needing
# someone with an ssh key.
#
# `PRAGMA user_version` and not `integrity_check`: the rollback happens when
# a read-write connection first reads the database and notices the journal --
# and a WAL replay happens on that same first open, for the same reason -- so
# the cheapest possible read is enough. A real check of a 1.1 GB library
# on a Pi Zero 2W would add minutes to every boot to answer a question that
# was not asked.
set -u

# **`[PI-PRE-030]` The recovery needs one external command, and it may be
# either of two.** This script's whole value is that it is never fatal -- it
# reports what it cannot open and lets the player start -- and that same
# property is what would hide the loss of `sqlite3`: recovery would stop
# happening, and the log would say only "could not open", the same words it
# uses for a genuinely broken database. The next power cut would be the crash
# loop again, long after the change that caused it.
#
# So it resolves a runner instead of naming one. `python3` is on every Lempi
# appliance because the tooling already assumes it, and for THIS act it is
# not a lesser substitute: measured on `lempipi` 2026-09-11, against a WAL
# database carrying un-checkpointed frames and against a hot rollback journal
# whose dirty pages had really spilled into the database file, `python3` and
# `sqlite3` gave identical outcomes -- frames replayed and the `-wal` removed,
# the journal rolled back and deleted. Both recover because both open the
# database read-write and read one page; the recovery is SQLite's, not the
# command's, which is why the command can be swapped.
#
# `lempi-preflight` reports which of the two is armed, at every start.
if command -v sqlite3 >/dev/null 2>&1; then
    RUNNER=sqlite3
elif command -v python3 >/dev/null 2>&1; then
    RUNNER=python3
else
    RUNNER=
fi

# One read-write open, one cheap read. Writes nothing itself: the rollback or
# the WAL replay is what SQLite does on the way in.
open_rw() {
    case "$RUNNER" in
        sqlite3)
            sqlite3 "$1" 'PRAGMA user_version;'
            ;;
        python3)
            python3 -c 'import sqlite3, sys
c = sqlite3.connect(sys.argv[1])
c.execute("PRAGMA user_version").fetchone()
c.close()' "$1"
            ;;
        *)
            echo "no sqlite3 and no python3 on this host; cannot recover" >&2
            return 1
            ;;
    esac
}

DB="${LEMPI_DB:-/srv/library/library.db}"
LIB="${LEMPI_LIBRARY_DB:-/srv/library/library.db}"
LISTENER="${LEMPI_LISTENER_DB:-/var/lempi/listener.db}"

for db in "$DB" "$LIB" "$LISTENER"; do
    [ -f "$db" ] || continue
    # **`[PI-PRE-090]` Once the halves exist, the whole database is a rollback
    # artifact and recovering it is pure cost.** `$DB` is the pre-split file.
    # After `[IMPL-DBSPLIT-025]` the player opens the two halves and never
    # touches it again -- but this script still opened it read-write at every
    # single boot: on `lempipi`, 1.16 GB of superseded database, mapped and
    # read on behalf of nobody, on the slowest machine in the ecosystem, at
    # the one moment it is trying to start.
    #
    # Measured before claiming worse: the file's own mtime has not moved since
    # 2026-09-08 across every boot since, so the open was wasted work rather
    # than damage. Its content is frozen at the split -- 38,554 plays, last one
    # 2026-09-07 02:34 -- while the live listener half has gone on past it.
    #
    # The test is the halves' own existence, not a hard-coded name, so it is
    # right on an appliance that has not been split yet -- there the halves are
    # absent, `$DB` is the live database, and it is recovered exactly as
    # before. Rolling back by removing the halves restores that automatically.
    #
    # Said out loud rather than skipped in silence, because the file is still
    # sitting there taking a gigabyte: the line stops the day it is deleted.
    if [ "$db" = "$DB" ] && [ -f "$LIB" ] && [ -f "$LISTENER" ]; then
        echo "lempi-db-recover: not recovering $db, superseded by the split halves"
        continue
    fi
    # Evidence of an unclean stop is the whole reason this runs; say so when
    # there is some, so the boot log carries the fact rather than leaving it
    # to be deduced later.
    #
    # Two forms, and they are not equally strong. A `-journal` existing at all
    # is conclusive. A `-wal` existing is not -- that is what a WAL database
    # in use looks like -- so it has to be non-empty (`-s`), which at this
    # point in boot, with nothing yet holding the database open, means frames
    # that were never checkpointed.
    if [ -f "$db-journal" ]; then
        echo "lempi-db-recover: hot journal on $db, rolling back"
    elif [ -s "$db-wal" ]; then
        echo "lempi-db-recover: un-checkpointed WAL on $db, replaying"
    fi
    # stderr is CAPTURED, not discarded. The first version sent it to
    # /dev/null and reported only "could not open", which is what it then did
    # on a live boot -- announcing a hot journal it had failed to roll back and
    # saying nothing about why, in a script whose entire purpose is recovering
    # from that exact state. An instrument that reports a failure without its
    # cause makes the next person guess, and this one had already cost that
    # once `[PI3-FOUND-120]`.
    if err="$(open_rw "$db" 2>&1 >/dev/null)"; then
        # The same asymmetry on the way out. A surviving `-journal` is worth
        # reporting; a surviving `-wal` is only worth reporting if it still
        # holds frames, since the last connection to close a WAL database
        # checkpoints and removes it, and an empty one left behind is
        # ordinary rather than a failure.
        if [ -f "$db-journal" ]; then
            echo "lempi-db-recover: $db still journalled after recovery" >&2
        elif [ -s "$db-wal" ]; then
            echo "lempi-db-recover: $db still has un-checkpointed WAL after recovery" >&2
        fi
    else
        # Never fatal. A database this cannot open is a problem the player
        # itself will report far better than a pre-start script can, and
        # refusing to start is strictly worse than starting and saying so.
        echo "lempi-db-recover: could not open $db: ${err:-no error text}" >&2
    fi
done
exit 0

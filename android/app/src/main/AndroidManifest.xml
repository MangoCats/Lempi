<?xml version="1.0" encoding="utf-8"?>
<!-- The device spike [GDE-APP-020]: the player in a foreground service, its
     own skin in a WebView. Each permission is the narrowest that works
     [REQ-AND-220]. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The player's web server is a socket, even on loopback. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Decoding and ticking must keep the CPU while the screen is off; this is
         what the spike's drain measurement is a measurement of. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The music in shared storage [REQ-AND-210]: by ordinary path, which is
         what [REQ-AND-920] asks. Android 11-12 name it one way, 13+ another. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <application
        android:label="Lempi"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- [REQ-AND-230]: a bundle from Vipunen, by the share sheet or
             "Open with" (a .zip), or from Lempi's own menu (a .zip or a
             folder, through the system pickers, which grant access to that
             one document or folder and nothing else [REQ-AND-220]). -->
        <activity
            android:name=".ImportActivity"
            android:label="Import to Lempi"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
        </activity>

        <!-- [REQ-AND-120]: the player lives here, not in the activity, so it
             outlives the screen. -->
        <!-- [REQ-AND-195]: a backup of the listening, written where the user
             chooses in Android's own save dialog. -->
        <activity
            android:name=".BackupActivity"
            android:label="Export a backup"
            android:exported="false" />

        <!-- [REQ-AND-280]: music the phone found, sent to Vipunen. -->
        <activity
            android:name=".SendActivity"
            android:label="Send music to Vipunen"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- [REQ-AND-130]: also the media session's service, which the system,
             Bluetooth and Android Auto bind to, and so exported. Media3
             answers them; nothing here plays audio for them. -->
        <service
            android:name=".PlayerService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Android Auto finds media apps by this [REQ-AND-130]. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>
</manifest>

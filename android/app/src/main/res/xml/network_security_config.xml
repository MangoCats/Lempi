<!-- Plain HTTP, to two places only: the player's own server on loopback,
     where the launch key keeps other apps out [REQ-AND-160]; and the Vipunen
     node the user names, to send it music [REQ-AND-285]. That node is any
     address the user types, which no list here can name in advance, so plain
     HTTP is allowed in general. The app makes no other requests. The intake's
     key keeps out mistakes, not people [REQ-AND-287]. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
